# ============================================================================
# GroupGuard POC — קובץ קונפיגורציה לחיבוריות (API connectivity)
# העתק קובץ זה ל-.env ומלא את הערכים. אין להעלות את .env בפועל ל-git.
# ============================================================================

# ---- ליבת השירות (FastAPI core service) ----------------------------------
CORE_SERVICE_HOST=0.0.0.0
CORE_SERVICE_PORT=8000
# כתובת שאליה ה-connector (הקורא) שולח אירועים נכנסים
CORE_SERVICE_URL=http://localhost:8000
# סוד משותף בין ה-connector לשירות הליבה, לאימות בקשות ה-webhook
CONNECTOR_SHARED_SECRET=change-me-to-a-long-random-string

# מסלול קובץ מסד הנתונים (SQLite, מספיק ל-POC)
DATABASE_PATH=./data/groupguard.db
MEDIA_STORAGE_PATH=./data/media

# ---- Anthropic API (סיווג טקסט + הבנת מדיה/Vision) ------------------------
ANTHROPIC_API_KEY=
# מודל לסיווג הודעות (מהיר/זול) ומודל לסיכומים/תמצות (חזק יותר)
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5
ANTHROPIC_MODEL_SUMMARIZE=claude-sonnet-4-5

# ---- מספר קורא (Reader) — ספק לא-רשמי, Baileys (connector-whatsapp) ------
# תיקיית האימות (QR / session) של Baileys. לא לגעת ידנית.
CONNECTOR_AUTH_DIR=./connector-whatsapp/auth
# אין צורך למלא את זה ידנית! מזהה קבוצת הוואטסאפ לניטור מזוהה ונקשר
# אוטומטית ע"י הליבה בפעם הראשונה שמגיעה הודעה מהקבוצה שאליה הוספתם את
# מספר ה-Reader, בתנאי שאשף ההרשמה הושלם קודם (ראו app/main.py, הפונקציה
# whatsapp_reader_webhook). השדה הזה נשאר ריק בכוונה ומשמש רק כעקיפה ידנית
# לצורכי דיבוג/פיתוח, אם בכל זאת רוצים לקבע קבוצה מסוימת מראש.
MONITORED_GROUP_ID=
# מספר הטלפון הנייד (E.164, לדוגמה +972501234567) שדרכו יעבוד הסוכן — זהו
# המספר שיש לצרף לקבוצות הוואטסאפ המנוטרות. הזינו אותו כאן *לפני* ההרצה
# הראשונה של ה-connector: הוא ישתמש בו כדי להתחבר לוואטסאפ באמצעות קוד
# צימוד (Pairing Code) שיוצג בטרמינל, במקום סריקת QR (ראו connector-whatsapp/README.md).
# אם משאירים ריק — ה-connector חוזר לזרימת ה-QR הרגילה. אותו ערך גם מוצג
# למשתמש הקצה בסוף אשף ההרשמה כמספר שיש להוסיף לקבוצה.
READER_WHATSAPP_NUMBER="+972501234567"
# האם לשלוח הודעת גילוי נאות בהצטרפות הבוט לקבוצה (נדרש מטעמי חוק הגנת הפרטיות)
SEND_DISCLOSURE_MESSAGE=true
DISCLOSURE_MESSAGE_TEXT="קבוצה זו מנוטרת ע\"י GroupGuard לצורך אכיפת חוקי הקבוצה."

# ---- מספר שולח (Sender) — WhatsApp Business Cloud API הרשמי של Meta -------
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WA_CLOUD_API_TOKEN=
WA_CLOUD_API_PHONE_NUMBER_ID=
WA_CLOUD_API_BUSINESS_ACCOUNT_ID=
WA_CLOUD_API_VERSION=v20.0
# שם תבנית ההודעה המאושרת לשליחת התראות (Message Template, נדרשת אישור מראש ב-Meta)
WA_ALERT_TEMPLATE_NAME=groupguard_alert
WA_ALERT_TEMPLATE_LANG=he
# אם false — התראות יירשמו רק ביומן/בפאנל המקומי ולא יישלחו בפועל בוואטסאפ (מומלץ עד שהתבנית תאושר)
ALERTS_SEND_VIA_WHATSAPP=false

# ---- שליחת מייל — SMTP של Gmail (דו"ח יומי) --------------------------------
# דורש אימות דו-שלבי (2-Step Verification) פעיל בחשבון ה-Gmail, ו-App Password:
# https://myaccount.google.com/apppasswords  ->  יצירת סיסמה חדשה ל"אפליקציה אחרת"
# (סיסמת החשבון הרגילה לא תעבוד כאן — Google חוסמת "אפליקציות פחות מאובטחות")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# כתובת ה-Gmail המלאה — משמשת גם להתחברות וגם ככתובת השולח בדו"ח
SMTP_USER=
# ה-App Password בן 16 התווים שקיבלתם מגוגל, בלי רווחים (לדוגמה: abcdabcdabcdabcd)
SMTP_PASSWORD=
# אין צורך למלא את זה ידנית! נמען הדו"ח היומי הוא כתובת המייל של המשתמש
# שנרשם באשף ההרשמה (אותה כתובת ששימשה להתחברות לחשבון) — כך שהדו"ח תמיד
# מגיע למי שבאמת אחראי על הקבוצה המנוטרת. השדה הזה נשאר ריק בכוונה ומשמש
# רק כנפילה-לאחור אם מריצים build_and_send_daily_report לפני שיש חשבון כלל.
DAILY_REPORT_RECIPIENTS=
# שעת שליחת הדו"ח (שעון ישראל)
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=5
TIMEZONE=Asia/Jerusalem

# ---- כלליות ----------------------------------------------------------------
LOG_LEVEL=INFO
# רשת הגנה נוספת (defense-in-depth) נגד ניתוח הודעות שקדמו לצירוף מספר
# ה-Reader לקבוצה: הודעה שחותמת הזמן שלה ישנה יותר מכך (בשניות) לא תועבר
# לליבה כלל (ראו connector-whatsapp/index.js). לא אמור לקרות במצב תקין —
# WhatsApp לא משתף היסטוריה כהודעה חיה — אך זו הגנה מפורשת נוספת.
MAX_MESSAGE_AGE_SECONDS=300
GROUP_DISPLAY_NAME="קבוצת הפיילוט"

# --- Multi-tenant: התחברות משתמשי קצה + פאנל אדמין (CRM) ---
# מחרוזת אקראית וארוכה קבועה לחתימת session cookies. אל תשנו אחרי שיש
# משתמשים מחוברים — שינוי מנתק את כולם.
SECRET_KEY=
# סיסמת האדמין היחידה לצפייה בפאנל /admin (CRM של כל המשתמשים/הקבוצות).
ADMIN_PASSWORD=

# --- Deployment (Docker Compose + Caddy + Azure Container Registry) ---
# רלוונטי רק כשמריצים דרך docker-compose.yml על ה-VM, לא לפיתוח מקומי.
# הדומיין/hostname הציבורי (למשל ה-DNS name שקיבל ה-VM מ-Azure) — Caddy
# מנפיק עבורו אוטומטית תעודת HTTPS (Let's Encrypt).
SITE_ADDRESS=
# כתובת ה-registry ב-ACR (למשל myregistry.azurecr.io) — נדרש כדי ש-
# docker-compose ידע מאיזה registry למשוך את התמונות (core/connector).
ACR_LOGIN_SERVER=
